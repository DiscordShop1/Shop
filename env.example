*{box-sizing:border-box}body{margin:0;background:#08080c;color:#f7f5fb;font-family:Inter,Arial;line-height:1.5}body:before{content:"";position:fixed;width:500px;height:500px;background:#7c3aed22;filter:blur(130px);left:-180px;top:-160px;pointer-events:none}header{height:76px;border-bottom:1px solid #24242d;display:flex;align-items:center;padding:0 6%;gap:35px;position:sticky;top:0;background:#08080ce8;backdrop-filter:blur(15px);z-index:5}.brand{font-weight:800;font-size:17px}.brand span{color:#a78bfa}nav{display:flex;gap:28px;margin:auto;color:#aaa6b4;font-size:14px}nav a{color:inherit;text-decoration:none}button,.btn{border:1px solid #302b3b;background:#15151d;color:#fff;border-radius:11px;padding:11px 15px;cursor:pointer;font-weight:700}.btn{display:inline-block;background:linear-gradient(135deg,#8b5cf6,#6d28d9);border-color:#8b5cf6;text-decoration:none}header button b{background:#8b5cf6;border-radius:20px;padding:2px 7px}main{max-width:1200px;margin:auto;padding:0 24px}.hero{min-height:600px;display:grid;grid-template-columns:1fr 1fr;gap:55px;align-items:center}.hero small,section>small{color:#a78bfa;font-weight:800;letter-spacing:2px;font-size:11px}.hero h1{font-size:62px;line-height:1.03;letter-spacing:-3px;margin:20px 0}.hero h1 strong{display:block;color:#a78bfa}.hero p{color:#aaa6b4;max-width:560px;margin-bottom:28px}.banner{height:330px;border:1px solid #393242;border-radius:22px;background:radial-gradient(circle,#8b5cf633,transparent 55%),#111118;display:grid;place-content:center;text-align:center;position:relative;box-shadow:0 30px 80px #0008}.banner b{font-size:32px}.banner span{color:#9993a4;font-size:13px}.banner i,.banner em{position:absolute;background:#14141cee;border:1px solid #302b3b;padding:12px 15px;border-radius:12px;font-style:normal;font-weight:700;font-size:12px}.banner i{left:-20px;bottom:25px}.banner em{right:-20px;top:25px}section{padding:80px 0;border-bottom:1px solid #24242d}h2{font-size:36px;margin:10px 0 28px}.products{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.product{background:#101017;border:1px solid #282832;border-radius:18px;padding:18px;transition:.2s}.product:hover{transform:translateY(-5px);border-color:#7048a9}.icon{height:145px;border-radius:13px;background:radial-gradient(circle,#8b5cf622,transparent 60%),#09090e;display:grid;place-items:center;font-size:58px}.product small{color:#a78bfa}.product p{color:#aaa6b4;font-size:13px;min-height:42px}.bottom{display:flex;align-items:center;justify-content:space-between}.price{font-weight:800;font-size:20px}.filter{margin:0 7px 18px 0}.filter.active{background:#271a39;border-color:#7445ad}.benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.benefits article{background:#101017;border:1px solid #282832;border-radius:18px;padding:25px;font-size:25px}.benefits h3{font-size:17px}.benefits p,details p{color:#aaa6b4;font-size:14px}details{border-bottom:1px solid #24242d;padding:20px 0}summary{cursor:pointer;font-weight:700}footer{padding:28px 6%;color:#9993a4;display:flex;justify-content:space-between;font-size:12px}#drawer{position:fixed;right:-430px;top:0;width:min(430px,100%);height:100vh;background:#0e0e14;border-left:1px solid #2a2831;z-index:10;padding:24px;transition:.25s;display:flex;flex-direction:column}#drawer.open{right:0}.drawerHead{display:flex;justify-content:space-between;border-bottom:1px solid #292831}.drawerHead button,#closeModal{background:none;border:0;font-size:30px}.cartRow{display:flex;justify-content:space-between;padding:15px 0;border-bottom:1px solid #292831}.qty button{padding:5px 9px}.sum{margin-top:auto;border-top:1px solid #292831;padding-top:18px}.sum strong{float:right}.sum .btn{width:100%;margin-top:15px;text-align:center}#modal{display:none;position:fixed;inset:0;background:#000b;z-index:20;place-items:center;padding:20px}.modalCard{background:#111118;border:1px solid #342d40;border-radius:20px;padding:28px;width:min(520px,100%);position:relative}.modalCard #closeModal{position:absolute;right:15px;top:8px;color:#fff}.modalCard input,.modalCard textarea{width:100%;padding:13px;margin:8px 0;background:#09090e;border:1px solid #292831;border-radius:10px;color:#fff;font:inherit}.modalCard textarea{min-height:110px}.modalCard .btn{width:100%;text-align:center}#result{font-weight:700}@media(max-width:800px){nav{display:none}.hero{grid-template-columns:1fr;padding:65px 0}.banner{display:none}.products,.benefits{grid-template-columns:1fr 1fr}}@media(max-width:550px){.products,.benefits{grid-template-columns:1fr}.hero h1{font-size:46px}}
